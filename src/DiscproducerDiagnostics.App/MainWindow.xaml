<Window x:Class="DiscproducerDiagnostics.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Discproducer Diagnostics" Width="1250" Height="850" MinWidth="850" MinHeight="650" Background="#F3F5F9" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CCD3DF"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF0F5"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="White"/><Setter Property="RowHeight" Value="32"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="16,10"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="Discproducer Diagnostics" FontSize="28" FontWeight="SemiBold" Foreground="#182D4B"/><TextBlock Text="Read-only USB identification and status • Epson driver preserved" Foreground="#52637B" Margin="0,6,0,0"/></StackPanel>
  <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,18">
   <StackPanel>
    <WrapPanel Margin="0,0,0,12"><CheckBox Content="Simulation mode" IsChecked="{Binding Simulation}" IsEnabled="{Binding CanConfigure}" VerticalAlignment="Center" Margin="0,0,18,0"/><ComboBox ItemsSource="{Binding Scenarios}" SelectedItem="{Binding Scenario}" IsEnabled="{Binding CanConfigure}" Width="155"/><TextBlock Text="Query timeout (seconds)" VerticalAlignment="Center" Margin="20,0,8,0"/><TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="45" IsEnabled="{Binding CanConfigure}"/></WrapPanel>
    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" IsEnabled="{Binding CanSelect}" Margin="0,0,0,12" Padding="8" AutomationProperties.Name="Detected Epson devices"/>
    <WrapPanel><Button Content="Scan for Devices" Command="{Binding ScanCommand}"/><Button Content="Connect" Command="{Binding ConnectCommand}"/><Button Content="Disconnect" Command="{Binding DisconnectCommand}"/><Button Content="Refresh Status" Command="{Binding RefreshCommand}"/><Button Content="Cancel" Command="{Binding CancelCommand}"/></WrapPanel>
    <TextBlock Text="{Binding Connection}" Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Notice}" Margin="0,6,0,0" Foreground="#675122" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <TabControl Grid.Row="2">
   <TabItem Header="Device information"><DataGrid ItemsSource="{Binding Facts}"><DataGrid.Columns><DataGridTextColumn Header="Field" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="260"/><DataGridTextColumn Header="Availability" Binding="{Binding Availability}" Width="160"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Status"><DataGrid ItemsSource="{Binding Statuses}" RowHeight="Auto"><DataGrid.Columns><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="220"/><DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="75"/><DataGridTextColumn Header="Raw" Binding="{Binding Raw}" Width="100"/><DataGridTextColumn Header="Interpretation" Binding="{Binding Interpretation}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="6"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Availability" Binding="{Binding Availability}" Width="180"/><DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="180"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Communication log"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog}" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="100"/><DataGridTextColumn Header="Simulated" Binding="{Binding Simulated}"/><DataGridTextColumn Header="Direction" Binding="{Binding Direction}"/><DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="200"/><DataGridTextColumn Header="Transport" Binding="{Binding Transport}" Width="170"/><DataGridTextColumn Header="Hex" Binding="{Binding Hex}" Width="250"/><DataGridTextColumn Header="ASCII" Binding="{Binding Ascii}" Width="250"/><DataGridTextColumn Header="Bytes" Binding="{Binding Length}"/><DataGridTextColumn Header="ms" Binding="{Binding DurationMs, StringFormat=F1}"/><DataGridTextColumn Header="Success" Binding="{Binding Success}"/><DataGridTextColumn Header="Code" Binding="{Binding ErrorCode}"/><DataGridTextColumn Header="Detail" Binding="{Binding Error}" Width="300"/></DataGrid.Columns></DataGrid><Button Grid.Row="1" Content="Copy selected entry (unredacted)" Command="{Binding CopyCommand}" HorizontalAlignment="Left" Margin="8"/></Grid></TabItem>
  </TabControl>
  <WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button Content="Export Diagnostic Bundle…" Command="{Binding ExportCommand}" Background="#DFEAFF"/><CheckBox Content="Redact identifiers and raw payloads in export" IsChecked="{Binding Redact}" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBlock Text="No writes • No resets • No cleaning" Foreground="#52637B" Margin="24,0,0,0" VerticalAlignment="Center"/></WrapPanel>
 </Grid>
</Window>
