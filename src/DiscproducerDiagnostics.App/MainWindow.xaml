<Window x:Class="DiscproducerDiagnostics.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:DiscproducerDiagnostics.Core;assembly=DiscproducerDiagnostics.Core" Title="Discproducer Diagnostics" Width="1250" Height="850" MinWidth="850" MinHeight="650" Background="#F3F5F9" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <HierarchicalDataTemplate DataType="{x:Type core:InspectionNode}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="2,4"/></HierarchicalDataTemplate>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CCD3DF"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF0F5"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="White"/><Setter Property="RowHeight" Value="32"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="16,10"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="Discproducer Diagnostics" FontSize="28" FontWeight="SemiBold" Foreground="#182D4B"/><TextBlock Text="Read-only USB identification and status • Epson driver preserved" Foreground="#52637B" Margin="0,6,0,0"/></StackPanel>
  <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,18">
   <StackPanel>
    <WrapPanel Margin="0,0,0,12"><CheckBox Content="Simulation mode" IsChecked="{Binding Simulation}" IsEnabled="{Binding CanConfigure}" VerticalAlignment="Center" Margin="0,0,18,0"/><ComboBox ItemsSource="{Binding Scenarios}" SelectedItem="{Binding Scenario}" IsEnabled="{Binding CanConfigure}" Width="155"/><TextBlock Text="Query timeout (seconds)" VerticalAlignment="Center" Margin="20,0,8,0"/><TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="45" IsEnabled="{Binding CanConfigure}"/></WrapPanel>
    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" IsEnabled="{Binding CanSelect}" Margin="0,0,0,12" Padding="8" AutomationProperties.Name="Detected Epson devices"/>
    <WrapPanel><Button Content="Scan for Devices" Command="{Binding ScanCommand}"/><Button Content="Connect" Command="{Binding ConnectCommand}"/><Button Content="Disconnect" Command="{Binding DisconnectCommand}"/><Button Content="Run Full Diagnostics" Command="{Binding FullDiagnosticsCommand}"/><Button Content="Refresh Status" Command="{Binding RefreshCommand}"/><Button Content="Cancel" Command="{Binding CancelCommand}"/></WrapPanel>
    <TextBlock Text="{Binding Connection}" Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Progress}" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Notice}" Margin="0,6,0,0" Foreground="#675122" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <TabControl Grid.Row="2">
   <TabItem Header="Device information"><DataGrid ItemsSource="{Binding Facts}"><DataGrid.Columns><DataGridTextColumn Header="Field" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="260"/><DataGridTextColumn Header="Availability" Binding="{Binding Availability}" Width="160"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="USB Interfaces"><DockPanel Margin="8"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button Content="Inspect descriptors" Command="{Binding InspectInterfacesCommand}"/><Button Content="Copy details (unredacted)" Command="{Binding CopyInterfacesCommand}"/><Button Content="Export tree…" Command="{Binding ExportInterfacesCommand}"/></WrapPanel><TreeView ItemsSource="{Binding InterfaceTree}" BorderThickness="0" VirtualizingStackPanel.IsVirtualizing="True"/></DockPanel></TabItem>
   <TabItem Header="Windows Printer"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="130"/><RowDefinition Height="*"/><RowDefinition Height="140"/></Grid.RowDefinitions><Button Content="Inspect queues and jobs" Command="{Binding InspectPrintersCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/><DataGrid Grid.Row="1" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}"><DataGrid.Columns><DataGridTextColumn Header="Queue" Binding="{Binding Queue.Name}" Width="*"/><DataGridTextColumn Header="Port" Binding="{Binding Queue.Port}"/><DataGridTextColumn Header="Driver" Binding="{Binding Queue.Driver}" Width="180"/><DataGridTextColumn Header="Jobs" Binding="{Binding Queue.Jobs}"/><DataGridTextColumn Header="Association" Binding="{Binding Association}" Width="240"/></DataGrid.Columns></DataGrid><TextBox Grid.Row="2" Text="{Binding PrinterDetails, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,8"/><DataGrid Grid.Row="3" ItemsSource="{Binding PrinterJobs}"><DataGrid.Columns><DataGridTextColumn Header="Job" Binding="{Binding Id}"/><DataGridTextColumn Header="Document (private)" Binding="{Binding Document}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/><DataGridTextColumn Header="Raw status" Binding="{Binding RawStatus}"/><DataGridTextColumn Header="Bytes" Binding="{Binding Size}"/><DataGridTextColumn Header="Submitted UTC" Binding="{Binding SubmittedUtc}" Width="200"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="Protocol Explorer"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><ComboBox ItemsSource="{Binding Commands}" SelectedItem="{Binding SelectedCommand}" Padding="8"/><TextBox Grid.Row="1" Text="{Binding CommandDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8"/><WrapPanel Grid.Row="2" Margin="0,0,0,8"><Button Content="Execute read-only query" Command="{Binding ExecuteProtocolCommand}"/><Button Content="Cancel" Command="{Binding CancelCommand}"/><TextBlock Text="Raw request / response is available in Communication Log" VerticalAlignment="Center"/></WrapPanel><TextBox Grid.Row="3" Text="{Binding ExplorerResult, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></Grid></TabItem>
   <TabItem Header="USB Capture"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
    <Expander Header="Capture guide and installed tools"><StackPanel><TextBlock Text="Passive workflow: identify the device topology in USB Interfaces → select the matching USBPcap root hub in Wireshark → start capture → perform one status refresh in Epson Total Disc Monitor → stop → save as PCAPNG → import here. Capture requires your explicit action in external software. No capture driver is installed, and no packet is replayed. Captures can contain private print data, filenames and serial numbers." TextWrapping="Wrap" Margin="8"/><Button Content="Detect installed tools" Command="{Binding DetectCaptureToolsCommand}" HorizontalAlignment="Left"/><DataGrid ItemsSource="{Binding CaptureTools}" Height="100"><DataGrid.Columns><DataGridTextColumn Header="Component" Binding="{Binding Name}" Width="200"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/><DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="130"/><DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="300"/></DataGrid.Columns></DataGrid></StackPanel></Expander>
    <StackPanel Grid.Row="1" Margin="0,8"><WrapPanel Margin="0,0,0,6"><Button Content="Import .pcapng…" Command="{Binding ImportCaptureCommand}"/><TextBlock Text="Bus:address" VerticalAlignment="Center" Margin="4"/><TextBox Text="{Binding CaptureDeviceFilter}" Width="70"/><TextBlock Text="Endpoint" VerticalAlignment="Center" Margin="8,0,4,0"/><TextBox Text="{Binding CaptureEndpointFilter}" Width="60"/><ComboBox ItemsSource="{Binding Directions}" SelectedItem="{Binding CaptureDirectionFilter}" Width="80" Margin="8,0"/><ComboBox ItemsSource="{Binding CaptureTypes}" SelectedItem="{Binding CaptureTypeFilter}" Width="110"/></WrapPanel><WrapPanel><TextBlock Text="From / to (ISO time)" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Text="{Binding CaptureFrom}" Width="140"/><TextBox Text="{Binding CaptureTo}" Width="140" Margin="4,0"/><TextBlock Text="Payload text or hex:" VerticalAlignment="Center" Margin="8,0,4,0"/><TextBox Text="{Binding CaptureSearch}" Width="140"/><Button Content="Filter" Command="{Binding FilterCaptureCommand}" Margin="8,0"/><Button Content="Compare with selected app transaction" Command="{Binding CompareCommand}"/><Button Content="Copy capture hex" Command="{Binding CopyCaptureHexCommand}"/><Button Content="Save capture payload…" Command="{Binding SaveCapturePayloadCommand}"/></WrapPanel></StackPanel>
    <DataGrid Grid.Row="2" ItemsSource="{Binding CapturePackets}" SelectedItem="{Binding SelectedPacket}" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Number}"/><DataGridTextColumn Header="UTC" Binding="{Binding TimestampUtc, StringFormat=O}" Width="210"/><DataGridTextColumn Header="Bus:addr" Binding="{Binding Device}"/><DataGridTextColumn Header="Endpoint" Binding="{Binding EndpointText}"/><DataGridTextColumn Header="Direction" Binding="{Binding Direction}"/><DataGridTextColumn Header="Transfer" Binding="{Binding TransferType}"/><DataGridTextColumn Header="Status" Binding="{Binding StatusText}"/><DataGridTextColumn Header="Correlation" Binding="{Binding Correlation}" Width="*"/></DataGrid.Columns></DataGrid>
    <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="90"/></Grid.RowDefinitions><TextBox Text="{Binding CaptureDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBox Grid.Column="1" Text="{Binding CaptureHex, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/><TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CaptureResult, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"/></Grid>
   </Grid></TabItem>
   <TabItem Header="Status"><DataGrid ItemsSource="{Binding Statuses}" RowHeight="NaN"><DataGrid.Columns><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="220"/><DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="75"/><DataGridTextColumn Header="Raw" Binding="{Binding Raw}" Width="100"/><DataGridTextColumn Header="Interpretation" Binding="{Binding Interpretation}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="6"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Availability" Binding="{Binding Availability}" Width="180"/><DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="180"/></DataGrid.Columns></DataGrid></TabItem>
<TabItem Header="Communication Log"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,8"><TextBlock Text="Command / endpoint / outcome" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding LogFilter}" Width="180"/><TextBlock Text="Setup direction" VerticalAlignment="Center" Margin="12,0,6,0"/><ComboBox ItemsSource="{Binding Directions}" SelectedItem="{Binding LogDirection}" Width="80"/><Button Content="Filter" Command="{Binding FilterLogsCommand}" Margin="8,0"/></WrapPanel><DataGrid Grid.Row="1" ItemsSource="{Binding VisibleTransactions}" SelectedItem="{Binding SelectedTransaction}" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="UTC timestamp" Binding="{Binding TimestampUtc, StringFormat=O}" Width="220"/><DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="*"/><DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="90"/><DataGridTextColumn Header="Request" Binding="{Binding RequestLength}"/><DataGridTextColumn Header="Response" Binding="{Binding ResponseLength}"/><DataGridTextColumn Header="ms" Binding="{Binding DurationMs, StringFormat=F3}"/><DataGridTextColumn Header="Native code" Binding="{Binding NativeError}"/><DataGridTextColumn Header="Simulated" Binding="{Binding Simulated}"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="2" Margin="0,8"><ComboBox ItemsSource="{Binding PayloadKinds}" SelectedItem="{Binding PayloadKind}" Width="100" Margin="0,0,8,0"/><Button Content="Copy hex" Command="{Binding CopyHexCommand}"/><Button Content="Copy ASCII" Command="{Binding CopyAsciiCommand}"/><Button Content="Copy transaction" Command="{Binding CopyTransactionCommand}"/><Button Content="Save binary…" Command="{Binding SavePayloadCommand}"/><Button Content="Save JSON…" Command="{Binding SaveTransactionCommand}"/><TextBlock Text="Copies and individual saves are unredacted" VerticalAlignment="Center"/></WrapPanel><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding TransactionDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBox Grid.Column="1" Text="{Binding TransactionHex, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/></Grid></Grid></TabItem>
  </TabControl>
  <WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button Content="Export Diagnostic Bundle…" Command="{Binding ExportCommand}" Background="#DFEAFF"/><ComboBox ItemsSource="{Binding ExportModes}" SelectedItem="{Binding SelectedExportMode}" Width="200" Margin="8,0" VerticalAlignment="Center"/><TextBlock Text="No writes • No resets • No cleaning" Foreground="#52637B" Margin="24,0,0,0" VerticalAlignment="Center"/></WrapPanel>
 </Grid>
</Window>
